# Steam credentials — ОПЦИОНАЛЬНО (можно войти по QR-коду при запуске)
STEAM_USERNAME=
STEAM_PASSWORD=
# shared_secret из SDA (Steam Desktop Authenticator) для авто-2FA
STEAM_SHARED_SECRET=

# Язык консоли: ru / en (хот-релоад — меняется на лету)
LANG=ru

# Статус (опционально; если не задан — шаблон следует за языком LANG)
# STATUS_TEMPLATE=Listening to {title} • {artist}

# Источники трека (минимум один)
# LASTFM_API_KEY можно не заполнять — в бота встроен публичный ключ по умолчанию,
# достаточно вписать свой ник. Свой ключ: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=
# HTTP-прокси для last.fm (если регион заблокирован; v2rayN/clash):
# LASTFM_PROXY=http://127.0.0.1:10809
# Прокси для проверки обновлений (если не задан — берётся LASTFM_PROXY):
# UPDATE_PROXY=http://127.0.0.1:10809
STATSFM_USERNAME=

# Своя обложка-заглушка: если обложки трека нет нигде (iTunes и Cover Art
# Archive не нашли), используется эта картинка — путь к файлу или URL.
# Пусто = карточка на градиенте без обложки.
# DEFAULT_COVER=D:\pictures\my-cover.jpg

# Поллинг (5с = быстрое обнаружение; ниже 3с не рекомендуется)
POLL_INTERVAL_MS=2000

# Экспериментальный artwork showcase
SHOWCASE_ENABLED=true
SHOWCASE_MIN_INTERVAL_MS=60000
# 13 = витрина иллюстраций 2x2, 22 = избранная иллюстрация (одна большая)
SHOWCASE_TYPE=22
# Какой по счёту витрина на профиле (1 = первая сверху). В .env пишется с нуля:
# SHOWCASE_SLOT=0 — первая, 1 — вторая и т.д.
SHOWCASE_SLOT=0
# Ориентация карточки: wide — растянуть по ширине витрины,
# vertical — растянуть по высоте, none — обычная карточка без растяжения.
# (SHOWCASE_WIDE=true — устаревший синоним wide)
SHOWCASE_STRETCH=wide
# Убирать карточку из «Иллюстраций» при закрытии бота (Ctrl+C / закрытие окна).
# false — оставить арт в галерее и на витрине после выхода.
SHOWCASE_CLEAR_ON_EXIT=true
# Размер карточки: по умолчанию wide 2400x800, vertical 630x1200, none 630x800.
# Свои значения — раскомментировать (побеждают дефолт):
# CARD_WIDTH=2400
# CARD_HEIGHT=800
